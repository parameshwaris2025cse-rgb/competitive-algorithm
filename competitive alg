#include <stdio.h>

int main()
{
    int n;
    scanf("%d", &n);

    int count[n + 1];

    // Initialize frequency array
    for (int i = 0; i <= n; i++)
    {
        count[i] = 0;
    }

    for (int i = 0; i < n; i++)
    {
        int x;
        scanf("%d", &x);

        count[x]++;

        if (count[x] == 2)
        {
            printf("%d", x);
            return 0;
        }
    }

    return 0;
}



